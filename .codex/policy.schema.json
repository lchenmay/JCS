{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/codex/jcs-policy.schema.json",
  "title": "JCS project-local Codex policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "repository", "runtimePermissions", "baselineProtection", "sourcesOfTruth", "generatedPaths", "generators", "dependencies", "rules", "taskRouting", "riskClassification", "verification", "completionGate"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 4 },
    "mode": { "enum": ["audit", "enforce"] },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "root", "writeScope", "outsideRepository"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "writeScope": { "const": "repository-only" },
        "outsideRepository": { "const": "deny" }
      }
    },
    "runtimePermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["managedByRepository", "description"],
      "properties": {
        "managedByRepository": { "const": false },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "baselineProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "destructiveCommandPattern"],
      "properties": {
        "enabled": { "const": true },
        "destructiveCommandPattern": { "type": "string", "minLength": 1 }
      }
    },
    "sourcesOfTruth": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "patterns"],
        "properties": {
          "name": { "type": "string" },
          "patterns": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "generatedPaths": { "$ref": "#/$defs/stringArray" },
    "generators": {
      "type": "object",
      "required": ["trusted", "direct"],
      "properties": {
        "trusted": { "$ref": "#/$defs/stringArray" },
        "direct": { "$ref": "#/$defs/stringArray" }
      }
    },
    "protectedPaths": { "type": "array", "items": { "type": "object" } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "path", "relationship", "defaultAccess", "automaticVerification", "impactPatterns"],
        "properties": {
          "repository": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "relationship": { "enum": ["upstream", "downstream"] },
          "defaultAccess": { "const": "read-only" },
          "automaticVerification": { "const": false },
          "impactPatterns": { "$ref": "#/$defs/stringArray" }
        }
      }
    },
    "rules": { "type": "array", "items": { "type": "object" } },
    "taskRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "unknownStatus", "maxFocusedDiagnosticAttempts", "rulePacks"],
      "properties": {
        "enabled": { "const": true },
        "unknownStatus": { "const": "U" },
        "maxFocusedDiagnosticAttempts": { "type": "integer", "minimum": 1 },
        "rulePacks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "summary", "always", "minimumRisk", "promptPatterns", "pathPatterns", "requiredEvidence"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "always": { "type": "boolean" },
              "minimumRisk": { "$ref": "#/$defs/risk" },
              "promptPatterns": { "$ref": "#/$defs/stringArray" },
              "pathPatterns": { "$ref": "#/$defs/stringArray" },
              "requiredEvidence": { "$ref": "#/$defs/stringArray" }
            }
          }
        }
      }
    },
    "riskClassification": {
      "type": "object",
      "required": ["default", "levels", "pathRules"],
      "properties": {
        "default": { "$ref": "#/$defs/risk" },
        "levels": { "type": "object" },
        "pathRules": { "type": "array", "items": { "type": "object" } }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewEntryPoint", "entryPoint", "receiptPath", "receiptPathTemplate", "ignoredPaths", "coverageRules", "checks"],
      "properties": {
        "reviewEntryPoint": { "type": "string" },
        "entryPoint": { "type": "string" },
        "receiptPath": { "type": "string" },
        "receiptPathTemplate": { "type": "string", "pattern": "\\{sessionId\\}" },
        "ignoredPaths": { "$ref": "#/$defs/stringArray" },
        "coverageRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "patterns", "checkNames"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "patterns": { "$ref": "#/$defs/stringArray" },
              "checkNames": { "$ref": "#/$defs/stringArray" }
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "category", "evidenceLevels", "executable", "workingDirectory", "arguments", "whenPaths"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "category": { "type": "string", "minLength": 1 },
              "evidenceLevels": { "$ref": "#/$defs/stringArray" },
              "executable": { "type": "string", "minLength": 1 },
              "workingDirectory": { "type": "string", "minLength": 1 },
              "arguments": { "$ref": "#/$defs/stringArray" },
              "whenPaths": { "$ref": "#/$defs/stringArray" }
            }
          }
        }
      }
    },
    "completionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blockingMode", "maxRepeatedVerificationFailures"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blockingMode": { "enum": ["enforce"] },
        "maxRepeatedVerificationFailures": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk": { "enum": ["L1", "L2", "L3"] }
  }
}
