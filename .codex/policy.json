{
  "$schema": "./policy.schema.json",
  "version": 4,
  "mode": "audit",
  "repository": {
    "name": "JCS",
    "root": ".",
    "writeScope": "repository-only",
    "outsideRepository": "deny"
  },
  "runtimePermissions": {
    "managedByRepository": false,
    "description": "The Codex permission profile is selected by the runtime and is never changed by this repository."
  },
  "baselineProtection": {
    "enabled": true,
    "destructiveCommandPattern": "(?i)\\bgit(?:\\.exe)?\\s+(?:-c\\s+\\S+\\s+)?(?:restore|reset|clean)\\b|\\bgit(?:\\.exe)?\\s+(?:-c\\s+\\S+\\s+)?checkout\\b[^\\r\\n]*--|\\bgit(?:\\.exe)?\\s+stash\\s+(?:pop|drop|clear)\\b|\\b(?:Remove-Item|rm|del|erase|rmdir|git\\s+rm)\\b|\\b(?:os\\.remove|shutil\\.rmtree|unlink|rmSync|unlinkSync)\\s*\\("
  },
  "sourcesOfTruth": [
    {
      "name": "JCS shared schema",
      "patterns": ["JCS.Shared/Design-*.json", "BizShared/Design-*.json"]
    }
  ],
  "generatedPaths": [
    "JCS.Shared/OrmTypes.fs",
    "JCS.Shared/OrmMor.fs",
    "JCS.Shared/CustomMor.fs",
    "JCS.Shared/Types.fs",
    "JCS.Shared/sqlPostgreSQL.sql",
    "JCS.Shared/sqlSQLServer.sql",
    "BizShared/OrmTypes.fs",
    "BizShared/OrmTypes.d.ts",
    "BizShared/OrmMor.fs",
    "BizShared/OrmMor.ts",
    "BizShared/CustomMor.fs",
    "BizShared/CustomMor.ts",
    "BizShared/Types.fs",
    "BizShared/Types.d.ts",
    "portal/src/lib/shared/OrmTypes.d.ts",
    "portal/src/lib/shared/OrmMor.ts",
    "portal/src/lib/shared/CustomMor.ts",
    "portal/src/lib/shared/Types.d.ts",
    "vscode/src/lib/shared/OrmTypes.d.ts",
    "vscode/src/lib/shared/OrmMor.ts",
    "vscode/src/lib/shared/CustomMor.ts",
    "vscode/src/lib/shared/Types.d.ts",
    "VsCodeTemplate/src/lib/shared/OrmTypes.d.ts",
    "VsCodeTemplate/src/lib/shared/OrmMor.ts",
    "VsCodeTemplate/src/lib/shared/CustomMor.ts",
    "VsCodeTemplate/src/lib/shared/Types.d.ts"
  ],
  "generators": {
    "trusted": ["scripts/regenerate-types.ps1"],
    "direct": ["TypeSys/TypeSys.fsproj", "run-typesys-jcs.fsx"]
  },
  "protectedPaths": [
    {
      "name": "secret-bearing files",
      "pattern": "(?i)(^|[\\s/\\\\\"])(?:\\.env(?:\\.[^\\s/\\\\\"]+)?|[^\\s/\\\\\"]+\\.(?:pem|key|pfx|p12))(?=[\\s/\\\\\"]|$)",
      "risk": "L3"
    },
    {
      "name": "production configuration",
      "pattern": "(?i)(^|[\\s/\\\\])(?:deploy[\\/\\\\]prod|production(?:\\.|[\\/\\\\]))",
      "risk": "L3"
    }
  ],
  "dependencies": [
    {
      "repository": "Common",
      "path": "D:\\DEV\\Common",
      "relationship": "upstream",
      "defaultAccess": "read-only",
      "automaticVerification": false,
      "impactPatterns": []
    },
    {
      "repository": "Aiarwa",
      "path": "D:\\DEV\\Aiarwa",
      "relationship": "downstream",
      "defaultAccess": "read-only",
      "automaticVerification": false,
      "impactPatterns": ["TypeSys/**", "JCS.Shared/**", "BizShared/**"]
    }
  ],
  "rules": [
    {
      "name": "outside-repository-write",
      "kind": "outsideRepositoryWrite",
      "severity": "deny",
      "risk": "L3",
      "message": "Writes outside the active JCS Git root require a separate task with an explicitly added writable root."
    },
    {
      "name": "tracked-file-delete",
      "kind": "trackedFileDelete",
      "severity": "deny",
      "risk": "L3",
      "message": "Deleting or moving a tracked file requires a separately reviewed controlled deletion workflow."
    },
    {
      "name": "generated-file-direct-edit",
      "kind": "generatedPathEdit",
      "appliesToTools": ["Bash", "exec", "shell_command", "apply_patch", "Edit", "Write"],
      "severity": "deny",
      "risk": "L2",
      "message": "Use the controlled generator instead of editing a generated path directly."
    },
    {
      "name": "protected-file-edit",
      "kind": "protectedPathEdit",
      "appliesToTools": ["Bash", "exec", "shell_command", "apply_patch", "Edit", "Write"],
      "severity": "deny",
      "risk": "L3",
      "message": "Editing a protected or secret-bearing file through Codex is blocked."
    },
    {
      "name": "direct-generator-execution",
      "kind": "directGenerator",
      "severity": "deny",
      "risk": "L2",
      "message": "Run the repository controlled-generation wrapper instead."
    },
    {
      "name": "git-hard-reset",
      "kind": "commandRegex",
      "pattern": "(?i)\\bgit(?:\\.exe)?\\s+(?:-c\\s+\\S+\\s+)?reset\\s+--hard\\b",
      "severity": "deny",
      "risk": "L3",
      "message": "Hard reset can discard user work."
    },
    {
      "name": "git-destructive-clean",
      "kind": "commandRegex",
      "pattern": "(?i)\\bgit(?:\\.exe)?\\s+(?:-c\\s+\\S+\\s+)?clean\\s+[^\\r\\n]*(?:-fd|-df|-fdx|-dfx|--force)",
      "severity": "deny",
      "risk": "L3",
      "message": "Destructive git clean can remove untracked work."
    },
    {
      "name": "git-force-push",
      "kind": "commandRegex",
      "pattern": "(?i)\\bgit(?:\\.exe)?\\s+(?:-c\\s+\\S+\\s+)?push\\s+[^\\r\\n]*(?:--force(?:-with-lease)?|-f)\\b",
      "severity": "deny",
      "risk": "L3",
      "message": "Force push is forbidden."
    },
    {
      "name": "recursive-delete",
      "kind": "commandRegex",
      "pattern": "(?i)\\b(?:remove-item|rm|rmdir|del)\\b[^\\r\\n]*(?:-recurse|-rf|/s)\\b",
      "severity": "deny",
      "risk": "L3",
      "message": "Recursive delete requires a separately reviewed and recoverable operation."
    },
    {
      "name": "forceful-process-kill",
      "kind": "commandRegex",
      "pattern": "(?i)\\b(?:taskkill(?:\\.exe)?\\b[^\\r\\n]*/f|stop-process\\b[^\\r\\n]*-force)",
      "severity": "deny",
      "risk": "L3",
      "message": "Forceful process termination is blocked."
    },
    {
      "name": "external-side-effect",
      "kind": "commandRegex",
      "pattern": "(?i)\\b(ssh|scp|rsync|systemctl|restart-service|stop-service|psql)\\b|\\bdotnet\\s+ef\\s+database\\s+update\\b|\\bdeploy(?:ment)?\\b",
      "severity": "context",
      "risk": "L3",
      "message": "External, deployment, service, or database action requires an explicit current user request and scoped approval."
    }
  ],
  "taskRouting": {
    "enabled": true,
    "unknownStatus": "U",
    "maxFocusedDiagnosticAttempts": 1,
    "rulePacks": [
      {
        "name": "core",
        "summary": "Preserve the repository boundary, the user baseline, explicit side-effect authorization, and truthful evidence reporting.",
        "always": true,
        "minimumRisk": "L1",
        "promptPatterns": [],
        "pathPatterns": [],
        "requiredEvidence": []
      },
      {
        "name": "policy-infrastructure",
        "summary": "Validate project policy, hooks, schemas, selection logic, and completion behavior.",
        "always": false,
        "minimumRisk": "L2",
        "promptPatterns": ["(?i)\\b(policy|hook|agents\\.md|rule system)\\b|策略|规则系统|钩子"],
        "pathPatterns": [".codex/**", "AGENTS.md", "scripts/codex-*.ps1"],
        "requiredEvidence": ["policy"]
      },
      {
        "name": "bugfix",
        "summary": "Reproduce the defect and require focused behavioral regression evidence.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(fix|bug|wrong|error|broken|regression)\\b|修复|错误|不对|异常|失败|问题"],
        "pathPatterns": [],
        "requiredEvidence": ["behavioral"]
      },
      {
        "name": "feature",
        "summary": "Implement an acceptance behavior and require behavioral evidence for it.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(add|implement|feature|support|create|build)\\b|新增|实现|支持|添加|开发"],
        "pathPatterns": [],
        "requiredEvidence": ["behavioral"]
      },
      {
        "name": "refactor",
        "summary": "Preserve observable behavior while changing structure.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(refactor|cleanup|restructure|rename)\\b|重构|整理|改名|优化结构"],
        "pathPatterns": [],
        "requiredEvidence": ["structural", "behavioral"]
      },
      {
        "name": "generated-code",
        "summary": "Change authoritative sources and use the trusted generator; never patch generated outputs directly.",
        "always": false,
        "minimumRisk": "L2",
        "promptPatterns": ["(?i)\\b(generated|generator|typesys|regenerate|design json)\\b|生成代码|类型生成|生成类型|重新生成|设计文件|权威源"],
        "pathPatterns": ["TypeSys/**", "scripts/regenerate-types.ps1", "JCS.Shared/Design-*.json", "BizShared/Design-*.json"],
        "requiredEvidence": ["generation", "structural", "dependency"]
      },
      {
        "name": "shared-contract",
        "summary": "Treat shared API and serialized types as compatibility-sensitive contracts.",
        "always": false,
        "minimumRisk": "L2",
        "promptPatterns": ["(?i)\\b(public api|shared contract|shared type|breaking change)\\b|公共接口|共享类型|共享契约"],
        "pathPatterns": ["JCS.Shared/**", "BizShared/**"],
        "requiredEvidence": ["structural", "dependency"]
      },
      {
        "name": "backend",
        "summary": "Build the touched backend boundary and keep API and serialization behavior explicit.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(backend|server|api|bizlogics|f#|dotnet)\\b|后端|接口|服务端|业务逻辑"],
        "pathPatterns": ["JCS.BizLogics/**", "WebLogics/**", "Server/**", "AioServer/**"],
        "requiredEvidence": ["structural"]
      },
      {
        "name": "frontend",
        "summary": "Typecheck the touched frontend and require behavioral evidence for user-visible changes.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(frontend|portal|vscode|vue|typescript|ui)\\b|前端|页面|界面"],
        "pathPatterns": ["portal/**", "vscode/**", "VsCodeTemplate/**"],
        "requiredEvidence": ["structural"]
      },
      {
        "name": "ui-behavior",
        "summary": "Verify visible or interactive behavior rather than relying on typecheck alone.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(interaction|visual|responsive|click|dialog)\\b|交互|视觉|点击|弹窗|响应式"],
        "pathPatterns": [],
        "requiredEvidence": ["behavioral", "visual"]
      },
      {
        "name": "database",
        "summary": "Review migration direction, compatibility, backup, rollback, and target environment before any database action.",
        "always": false,
        "minimumRisk": "L3",
        "promptPatterns": ["(?i)\\b(database|migration|sql|postgres|sqlserver|schema migration)\\b|数据库|迁移|数据表"],
        "pathPatterns": ["**/*.sql", "**/Migrations/**"],
        "requiredEvidence": ["migration", "behavioral"]
      },
      {
        "name": "dependency",
        "summary": "Review lockfiles, compatibility, consumers, and build impact for dependency changes.",
        "always": false,
        "minimumRisk": "L2",
        "promptPatterns": ["(?i)\\b(dependency|package|upgrade|nuget|npm)\\b|依赖|升级包"],
        "pathPatterns": ["**/*.fsproj", "**/*.sln", "**/*.slnf", "**/package.json", "**/package-lock.json"],
        "requiredEvidence": ["dependency", "structural"]
      },
      {
        "name": "performance",
        "summary": "Use a fixed baseline and repeated measurements; never infer improvement from one run.",
        "always": false,
        "minimumRisk": "L2",
        "promptPatterns": ["(?i)\\b(performance|benchmark|latency|throughput|memory leak)\\b|性能|基准|延迟|吞吐|内存泄漏"],
        "pathPatterns": [],
        "requiredEvidence": ["performance"]
      },
      {
        "name": "security",
        "summary": "Require explicit threat, authorization, secret-handling, and negative-path evidence.",
        "always": false,
        "minimumRisk": "L3",
        "promptPatterns": ["(?i)\\b(security|auth|authorization|secret|credential|vulnerability)\\b|安全|认证|授权|密钥|漏洞"],
        "pathPatterns": ["**/Auth/**", "**/Security/**"],
        "requiredEvidence": ["security", "behavioral"]
      },
      {
        "name": "deployment",
        "summary": "Require an explicit current request, target, health check, rollback, and operation receipt.",
        "always": false,
        "minimumRisk": "L3",
        "promptPatterns": ["(?i)\\b(deploy|production|ssh|service|server rollout)\\b|部署|生产|服务器|上线"],
        "pathPatterns": ["deploy/**", "**/Dockerfile", "**/docker-compose*.yml"],
        "requiredEvidence": ["deployment"]
      },
      {
        "name": "documentation",
        "summary": "Preserve factual provenance and verify produced artifacts visually when layout matters.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(documentation|docs|readme|pdf|latex)\\b|文档|说明书|生成报告|编写报告|整理报告"],
        "pathPatterns": ["docs/**", "**/*.md", "**/*.tex"],
        "requiredEvidence": ["structural", "visual"]
      },
      {
        "name": "test",
        "summary": "Do not weaken, skip, or delete assertions to make a failing task appear successful.",
        "always": false,
        "minimumRisk": "L1",
        "promptPatterns": ["(?i)\\b(test|coverage|regression test)\\b|测试|覆盖率|回归"],
        "pathPatterns": ["**/test/**", "**/tests/**", "**/*.Tests/**"],
        "requiredEvidence": ["behavioral"]
      },
      {
        "name": "release",
        "summary": "Require explicit publication authorization, immutable version evidence, and a release receipt.",
        "always": false,
        "minimumRisk": "L3",
        "promptPatterns": ["(?i)\\b(release|publish|tag|version bump)\\b|发布|发版|打标签"],
        "pathPatterns": [],
        "requiredEvidence": ["release"]
      }
    ]
  },
  "riskClassification": {
    "default": "L1",
    "levels": {
      "L1": {
        "description": "Ordinary repository-local change with focused verification."
      },
      "L2": {
        "description": "Schema, generated code, shared API, policy, or dependency-sensitive change."
      },
      "L3": {
        "description": "Destructive, secret-bearing, production, database, service, or remote action.",
        "requiresExplicitAuthorizationForAction": true
      }
    },
    "pathRules": [
      {
        "risk": "L2",
        "patterns": [
          ".codex/**",
          "AGENTS.md",
          "scripts/codex-*.ps1",
          "scripts/regenerate-types.ps1",
          "TypeSys/**",
          "JCS.Shared/**",
          "BizShared/**"
        ]
      },
      {
        "risk": "L3",
        "patterns": [".env", ".env.*", "deploy/prod/**", "*.pem", "**/*.pem", "*.key", "**/*.key", "*.pfx", "**/*.pfx", "*.p12", "**/*.p12"]
      }
    ]
  },
  "verification": {
    "reviewEntryPoint": "scripts/codex-policy-review.ps1",
    "entryPoint": "scripts/codex-verify.ps1",
    "receiptPath": ".codex/out/verification-receipt.json",
    "receiptPathTemplate": ".codex/out/verification-receipt-{sessionId}.json",
    "ignoredPaths": [
      ".codex/out/**"
    ],
    "coverageRules": [
      {
        "name": "policy-infrastructure",
        "patterns": [".codex/**", "AGENTS.md", "scripts/codex-*.ps1"],
        "checkNames": ["policy-tests"]
      },
      {
        "name": "typesys",
        "patterns": ["TypeSys/**", "scripts/regenerate-types.ps1"],
        "checkNames": ["typesys-release-build", "jcs-shared-release-build", "jcs-bizlogics-release-build", "dependency-impact-readonly"]
      },
      {
        "name": "shared-contracts",
        "patterns": ["JCS.Shared/**", "BizShared/**"],
        "checkNames": ["jcs-shared-release-build", "jcs-bizlogics-release-build", "dependency-impact-readonly"]
      },
      {
        "name": "bizlogics",
        "patterns": ["JCS.BizLogics/**"],
        "checkNames": ["jcs-bizlogics-release-build"]
      },
      {
        "name": "web-logics",
        "patterns": ["WebLogics/**"],
        "checkNames": ["web-logics-release-build"]
      },
      {
        "name": "server",
        "patterns": ["Server/**"],
        "checkNames": ["server-release-build"]
      },
      {
        "name": "aio-server",
        "patterns": ["AioServer/**"],
        "checkNames": ["aio-server-release-build"]
      },
      {
        "name": "portal",
        "patterns": ["portal/**"],
        "checkNames": ["portal-typecheck"]
      },
      {
        "name": "vscode",
        "patterns": ["vscode/**"],
        "checkNames": ["vscode-typecheck"]
      },
      {
        "name": "template",
        "patterns": ["VsCodeTemplate/**"],
        "checkNames": ["template-typecheck"]
      }
    ],
    "checks": [
      {
        "name": "policy-tests",
        "category": "policy",
        "evidenceLevels": ["policy"],
        "executable": "pwsh.exe",
        "workingDirectory": ".",
        "arguments": ["-NoProfile", "-File", ".codex/hooks/Test-Policy.ps1", "-PolicyPath", ".codex/policy.json"],
        "whenPaths": [".codex/**", "AGENTS.md", "scripts/codex-*.ps1"]
      },
      {
        "name": "typesys-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "TypeSys/TypeSys.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "whenPaths": ["TypeSys/**", "scripts/regenerate-types.ps1"]
      },
      {
        "name": "jcs-shared-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "JCS.Shared/JCS.Shared.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "whenPaths": ["TypeSys/**", "JCS.Shared/**", "BizShared/**"]
      },
      {
        "name": "jcs-bizlogics-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "JCS.BizLogics/JCS.BizLogics.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "minimumRisk": "L2",
        "runAtOrAbove": false,
        "whenPaths": ["JCS.BizLogics/**", "TypeSys/**", "JCS.Shared/**", "BizShared/**"]
      },
      {
        "name": "dependency-impact-readonly",
        "category": "dependency",
        "evidenceLevels": ["dependency"],
        "executable": "pwsh.exe",
        "workingDirectory": ".",
        "arguments": ["-NoProfile", "-File", "scripts/codex-dependency-impact.ps1", "-Json"],
        "minimumRisk": "L2",
        "runAtOrAbove": false,
        "whenPaths": ["TypeSys/**", "JCS.Shared/**", "BizShared/**"]
      },
      {
        "name": "web-logics-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "WebLogics/WebLogics.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "whenPaths": ["WebLogics/**"]
      },
      {
        "name": "server-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "Server/Server.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "whenPaths": ["Server/**"]
      },
      {
        "name": "aio-server-release-build",
        "category": "build",
        "evidenceLevels": ["structural"],
        "executable": "dotnet",
        "workingDirectory": ".",
        "arguments": ["build", "AioServer/AioServer.fsproj", "-c", "Release", "--no-restore", "--no-dependencies"],
        "whenPaths": ["AioServer/**"]
      },
      {
        "name": "portal-typecheck",
        "category": "frontend",
        "evidenceLevels": ["structural"],
        "executable": "npm",
        "workingDirectory": "portal",
        "arguments": ["run", "test"],
        "preconditions": [
          {
            "kind": "anyPathExists",
            "paths": ["portal/node_modules/.bin/vue-tsc", "portal/node_modules/.bin/vue-tsc.cmd"],
            "message": "portal dependencies are not installed; vue-tsc is unavailable."
          }
        ],
        "whenPaths": ["portal/**"]
      },
      {
        "name": "vscode-typecheck",
        "category": "frontend",
        "evidenceLevels": ["structural"],
        "executable": "npm",
        "workingDirectory": "vscode",
        "arguments": ["run", "test"],
        "preconditions": [
          {
            "kind": "anyPathExists",
            "paths": ["vscode/node_modules/.bin/vue-tsc", "vscode/node_modules/.bin/vue-tsc.cmd"],
            "message": "vscode dependencies are not installed; vue-tsc is unavailable."
          }
        ],
        "whenPaths": ["vscode/**"]
      },
      {
        "name": "template-typecheck",
        "category": "frontend",
        "evidenceLevels": ["structural"],
        "executable": "npm",
        "workingDirectory": "VsCodeTemplate",
        "arguments": ["run", "test"],
        "preconditions": [
          {
            "kind": "anyPathExists",
            "paths": ["VsCodeTemplate/node_modules/.bin/vue-tsc", "VsCodeTemplate/node_modules/.bin/vue-tsc.cmd"],
            "message": "VsCodeTemplate dependencies are not installed; vue-tsc is unavailable."
          }
        ],
        "whenPaths": ["VsCodeTemplate/**"]
      }
    ]
  },
  "completionGate": {
    "enabled": true,
    "blockingMode": "enforce",
    "maxRepeatedVerificationFailures": 2
  }
}
