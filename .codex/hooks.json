{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/SessionStart.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "commandWindows": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/SessionStart.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "timeout": 10,
            "statusMessage": "Loading JCS project policy",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/UserPromptSubmit.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "commandWindows": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/UserPromptSubmit.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "timeout": 10,
            "statusMessage": "Selecting minimal JCS rule packs",
            "additionalContextLimit": 900
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec|shell_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/PreToolUse.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "commandWindows": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/PreToolUse.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "timeout": 10,
            "statusMessage": "Auditing JCS policy",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|exec|shell_command|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/PostToolUse.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "commandWindows": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/PostToolUse.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "timeout": 10,
            "statusMessage": "Tracking JCS verification state",
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/Stop.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "commandWindows": "pwsh.exe -NoProfile -Command \"& (Join-Path (& git rev-parse --show-toplevel) '.codex/hooks/Stop.ps1') -PolicyPath (Join-Path (& git rev-parse --show-toplevel) '.codex/policy.json')\"",
            "timeout": 10,
            "statusMessage": "Auditing JCS completion evidence"
          }
        ]
      }
    ]
  }
}
